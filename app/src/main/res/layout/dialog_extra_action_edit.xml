<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dialog_title_extra_action"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <!-- View ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_view_id"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/field_view_id"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:placeholderText="@string/hint_view_id">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_view_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Type: Padding / Margin / Gone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/action_type"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rg_action_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/action_type_padding"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_type_margin"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_type_gone"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_type_invisible"
                android:textSize="13sp" />

        </RadioGroup>

        <!-- Target Bar: Status / Navigation -->
        <LinearLayout
            android:id="@+id/layout_bar_direction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/target_bar"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rg_target_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_status_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_bar_status"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_nav_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:checked="true"
                    android:text="@string/target_bar_nav"
                    android:textSize="13sp" />

            </RadioGroup>

        </LinearLayout>

        <!-- Inset Strategy -->
        <LinearLayout
            android:id="@+id/layout_inset_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_use_system_insets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/switch_use_system_insets"
                android:textSize="13.5sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_custom_inset"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/field_custom_inset"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:placeholderText="0">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_custom_inset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ViewGroup & Child Index Settings -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_is_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/switch_is_group"
            android:textSize="13.5sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_self"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="@string/switch_self"
            android:textSize="13.5sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_child_index"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/field_child_index"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:placeholderText="-1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_child_index"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Delay -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_delay"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/field_delay"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:placeholderText="100">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Routes Filter -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_route_key"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/field_route_key"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:placeholderText="@string/hint_route_key">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_route_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_routes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/field_routes"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:placeholderText="@string/hint_routes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_routes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_route_exclusive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/switch_route_exclusive"
            android:textSize="13.5sp" />

        <!-- Dialog Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_action"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_action"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_save" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
